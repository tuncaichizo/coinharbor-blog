---
import ExchangeFees from '../../components/ExchangeFees.astro';
import { exchanges } from '../../data/exchanges';
import { copy } from '../../data/copy';

export function getStaticPaths() {
  return exchanges.map((exchange) => ({
    params: { exchange: exchange.slug },
    props: { exchange },
  }));
}

const { exchange } = Astro.props;
const content = copy.en[exchange.slug];
---
<ExchangeFees lang="en" exchange={exchange} content={content} />
